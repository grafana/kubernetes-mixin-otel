{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  semanticCommits: "enabled",
  minimumReleaseAge: "3 days",
  schedule: ["on Monday"],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["scripts/*.sh"],
      // Track both the tag and digest of annotated, pinned Docker images.
      matchStrings: [
        '# renovate: datasource=docker depName=(?<depName>\\S+)\\r?\\n[A-Z0-9_]+_IMAGE="[^\\s@"]+:(?<currentValue>[^\\s@:"]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
      ],
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      matchManagers: ["dockerfile", "docker-compose"],
      groupName: "docker",
    },
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["docker"],
      groupName: "docker",
    },
    {
      matchManagers: ["gomod"],
      groupName: "go",
    },
    {
      // v2.3.0+ tags declare module path github.com/alecthomas/kingpin/v2,
      // so bumps of the gopkg.in import path are invalid and break go build.
      // jsonnet-bundler still imports gopkg.in/alecthomas/kingpin.v2.
      matchPackageNames: ["gopkg.in/alecthomas/kingpin.v2"],
      allowedVersions: "<=2.2.6",
    },
    {
      matchManagers: ["jsonnet-bundler"],
      groupName: "jsonnet",
    },
  ],
}
